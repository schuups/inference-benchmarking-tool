# Engine Deployment + Service + Ingress (breithorn) — rendered by the Planner (§5).
# Labels per §7.1 so the Cleaner and per-run teardown can discover everything.
# The Ingress (host ibt-engine-<slug>.<ingress_domain>, nginx + cert-manager
# letsencrypt) is what the SLURM Benchmarker's load generator targets (§6.2); it
# renders only when the cluster declares an ingress_domain. Cert issuance +
# ingress wiring take ~2-3 min after apply — the orchestrator readiness wait
# tolerates that window (_await_ready).
# run_id: {{ run_id }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ibt-engine-{{ k8s_slug }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: inference-benchmarking
    inference-benchmarking/run-id: "{{ run_id }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ibt-engine-{{ k8s_slug }}
  template:
    metadata:
      labels:
        app: ibt-engine-{{ k8s_slug }}
        app.kubernetes.io/managed-by: inference-benchmarking
    spec:
{% if image_pull_secret %}
      imagePullSecrets:
      - name: {{ image_pull_secret }}   # JFrog dockerconfigjson (anonymous pull is 403)
{% endif %}
      nodeSelector:
        node.kubernetes.io/instance-type: {{ node_type }}
      tolerations:
      - { key: hpc, operator: Equal, value: "true", effect: NoSchedule }
      - { key: hpc, operator: Equal, value: "true", effect: NoExecute }
      containers:
      - name: engine
        image: {{ image }}
        # §8.2: pre-checks + sampler share the engine container; gate failure stops the pod
        command: ["bash", "-c"]
        args:
          - >
            bash /tools/benchmarker/prechecks/run_system_prechecks.sh &&
            { python3 /tools/benchmarker/hw_sampler.py --out /results/hw-$(hostname).ndjson
            --interval {{ hardware_sampling_interval_s }} & exec {{ engine_command }}; }
        env:
        - { name: PRECHECK_CLUSTER, value: "{{ cluster }}" }
        - { name: PRECHECK_SCOPE, value: "{{ precheck_scope }}" }
        - { name: PRECHECK_STORAGE_SCOPE, value: "{{ precheck_storage_scope }}" }
        - { name: PRECHECK_OUT, value: "/results/prechecks" }
        - { name: PRECHECK_ON_WARN, value: "{{ prechecks.system_prechecks_on_warn }}" }
        - { name: PRECHECK_ON_FAIL, value: "{{ prechecks.system_prechecks_on_fail }}" }
        - { name: SKIP_SYSTEM_PRECHECKS, value: "{{ '1' if prechecks.skip_system_prechecks else '0' }}" }
        - { name: NCCL_TESTS_VERSION, value: "{{ prechecks.collective_tests_version or '2.17.1' }}" }
        - { name: NCCL_TESTS_CACHE, value: "/results/collective-tests-cache" }
        - { name: NVSHMEM_REQUIRED, value: "{{ '1' if prechecks.shmem_required else '0' }}" }
        # Parity with the SLURM engine template: a single pod holds all GPUs, and
        # there is no multi-node MPI launch (so the collective check spans the whole
        # pod, not just 1 GPU). See tools/templates/engine.sbatch.j2.
        - { name: PRECHECK_GPUS, value: "{{ total_gpus }}" }
        - { name: NCCL_TESTS_MPI, value: "0" }
        - { name: MSG_END, value: "128M" }
        # Resolve weights from the pre-populated HF cache on the model-cache PVC
        # (mounted read-only below) — no HF egress, no HF_TOKEN, no writes.
        - { name: HF_HOME, value: "/model-cache" }
        - { name: HF_HUB_OFFLINE, value: "1" }
        ports:
        - { containerPort: 8000, name: http, protocol: TCP }
        resources:
          requests:
            nvidia.com/gpu: {{ total_gpus }}
            ephemeral-storage: 60Gi
          limits:
            nvidia.com/gpu: {{ total_gpus }}
        startupProbe:
          httpGet: { path: /health, port: 8000 }
          periodSeconds: 10
          failureThreshold: {{ startup_failure_threshold }}
        volumeMounts:
        # read-only: the model-cache PVC is shared and may be owned/used by others —
        # a run must never mutate it (§7.6). Weights are pre-populated out-of-band.
        - { name: model-cache, mountPath: /model-cache, readOnly: true }
        - { name: results, mountPath: /results }
      volumes:
      - name: model-cache
        persistentVolumeClaim:
          # Org-inclusive slug to match the cluster's PVC naming (model_cache_slug,
          # NOT model_slug which drops the org). §7.6: kept across runs, never written.
          claimName: model-cache-{{ model_cache_slug }}
      - name: results
        persistentVolumeClaim:
          claimName: ibt-results-{{ k8s_slug }}
---
apiVersion: v1
kind: Service
metadata:
  name: ibt-engine-{{ k8s_slug }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: inference-benchmarking
    inference-benchmarking/run-id: "{{ run_id }}"
spec:
  selector:
    app: ibt-engine-{{ k8s_slug }}
  ports:
  - { port: 8000, targetPort: 8000, name: http }
{% if ingress_domain %}
---
# SLURM-Benchmarker-reachable endpoint (§6.2). nginx + cert-manager letsencrypt;
# the TLS cert is issued ~1-2 min after apply (HTTP-01), so the load generator's
# readiness wait must tolerate connection/cert errors during that window.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ibt-engine-{{ k8s_slug }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: inference-benchmarking
    inference-benchmarking/run-id: "{{ run_id }}"
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
    # Long LLM streaming requests + large prompt bodies.
    nginx.ingress.kubernetes.io/proxy-body-size: "16m"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "75"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "600"
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - ibt-engine-{{ k8s_slug }}.{{ ingress_domain }}
    secretName: ibt-engine-{{ k8s_slug }}-cert
  rules:
  - host: ibt-engine-{{ k8s_slug }}.{{ ingress_domain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: ibt-engine-{{ k8s_slug }}
            port:
              number: {{ engine_port }}
{% endif %}
