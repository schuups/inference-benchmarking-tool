#!/bin/bash
# Inference-deployment job — rendered by the Planner (§5); submitted by the
# Benchmarker orchestrator from within its allocation (§1, M7).
# run_id: {{ run_id }}

#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --job-name=ibt-engine-{{ run_id }}
#SBATCH --comment=inference-benchmarking
#SBATCH --output=%x-%j.out
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node={{ gpus_per_node }}
#SBATCH --gpus-per-node={{ gpus_per_node }}
#SBATCH --time={{ time_limit }}
#SBATCH --chdir={{ run_dir_remote }}
#
# The allocation carries {{ gpus_per_node }} tasks/node so the §8 pre-check step can
# run one rank per GPU (SPMD, --mpi=pmix); the engine step below uses 1 task/node.

export HUGGING_FACE_HUB_TOKEN=$(cat ~/.hf_token 2>/dev/null || true)
export HF_HOME={{ scratch_base }}/hf-cache

# §8 pre-check surface (graded by tools/benchmarker/prechecks/grade.py)
export PRECHECK_CLUSTER={{ cluster }}
export PRECHECK_SCOPE="{{ precheck_scope }}"
export PRECHECK_STORAGE_SCOPE="{{ precheck_storage_scope }}"   # fallback; run-storage.sh derives the real mount
export MODEL_ID="{{ model_id }}"                              # §8.1 storage check reads THIS model's shards
export PRECHECK_OUT={{ run_dir_remote }}/prechecks
export PRECHECK_ON_WARN={{ prechecks.system_prechecks_on_warn }}
export PRECHECK_ON_FAIL={{ prechecks.system_prechecks_on_fail }}
export SKIP_SYSTEM_PRECHECKS={{ "1" if prechecks.skip_system_prechecks else "0" }}
export NCCL_TESTS_VERSION={{ prechecks.collective_tests_version or "2.17.1" }}
export NCCL_TESTS_CACHE={{ prechecks.collective_tests_cache_dir or collective_tests_cache_dir }}
export NVSHMEM_REQUIRED={{ "1" if prechecks.shmem_required else "0" }}
export MSG_END=128M
# The pre-check runs as a dedicated step with one rank per GPU, so the collective
# build is always MPI (each rank drives a single GPU via -g 1); §8.2.
export NCCL_TESTS_MPI=1
export PRECHECK_GPUS=1
export PRECHECK_COLLECTIVES="{{ precheck_collectives }}"

{# Alps-extended images need --network=disable_rdzv_get alongside the CXI hook   #}
{# being disabled in the EDF; --mpi=pmix bootstraps both the SPMD pre-check ranks #}
{# and the engine (§9.1; docs.cscs.ch/software/alps-extended-images "Danger").    #}
{%- set net = " --network=disable_rdzv_get" if disable_cxi_hook else "" %}

# ---- §8 pre-checks: dedicated step, one rank per GPU (SPMD via PMIx) — gates the engine ----
# Same EDF (image / libfabric / CUDA / NCCL / mounts / --network / --mpi) as the engine, so the
# foundation measured is the engine's; the per-GPU rank topology is the engine's actual one (§8.2).
# --ntasks is set EXPLICITLY (one rank per GPU) — the allocation's SLURM_NTASKS would otherwise
# leak into the step and the engine step below must not inherit it (see its --ntasks).
srun --environment={{ run_dir_remote }}/engine.toml{{ net }} --nodes={{ nodes }} --ntasks={{ total_gpus }} --ntasks-per-node={{ gpus_per_node }} --mpi=pmix \
    bash {{ tools_remote }}/benchmarker/prechecks/run_system_prechecks.sh
precheck_rc=$?
if [ "${precheck_rc}" -ne 0 ]; then
    echo "[engine.sbatch] §8 pre-checks gated the run (exit ${precheck_rc}); not starting the engine" >&2
    exit "${precheck_rc}"
fi

{% if nodes > 1 -%}
# ---- multi-node Ray bring-up (E3 ladder) — head starts Ray, workers join, vLLM on the head ----
nodes_list=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
head_node=$(echo "$nodes_list" | head -1)
export VLLM_HOST_IP=$(hostname --ip-address)
RAY_CMD='if [ "$SLURM_NODEID" = "0" ]; then ray start --head --port=6379; else sleep 10 && ray start --address='"$head_node"':6379 --block; fi'
{% endif %}
# ---- engine step: one task PER NODE (vLLM drives its GPUs in-process / via Ray) ----
# --ntasks={{ nodes }} is EXPLICIT: the allocation is sized {{ gpus_per_node }} tasks/node for the
# pre-check step, so without this the engine step would inherit SLURM_NTASKS and launch one vLLM
# per GPU (4 servers contending for memory + clobbered hw-sampler). §13.3 sampler backgrounded
# in the same container session.
srun --environment={{ run_dir_remote }}/engine.toml{{ net }} --nodes={{ nodes }} --ntasks={{ nodes }} --ntasks-per-node=1 --mpi=pmix bash -c '
set -eo pipefail
python3 {{ tools_remote }}/benchmarker/hw_sampler.py \
    --out {{ run_dir_remote }}/hw-$(hostname).ndjson --interval {{ hardware_sampling_interval_s }} &
{% if nodes > 1 %}
'"$RAY_CMD"'
if [ "$SLURM_NODEID" = "0" ]; then
    exec {{ engine_command }} --distributed-executor-backend ray
else
    wait  # workers stay alive for Ray
fi
{% else %}
exec {{ engine_command }}
{% endif %}
'
