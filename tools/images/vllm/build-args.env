# Build provenance + pins (SPECIFICATIONS.md §8.1 build-args metadata).
# Sourced by build.sbatch; every value lands in the image labels / tags.

# Upstream alps HPC-stack source these files were vendored from:
ALPS_STACK_REPO=https://github.com/schuups/alps-extended-images
ALPS_STACK_BRANCH=vllm-image-test
ALPS_STACK_COMMIT=0431e103

# Stage 1: NGC base + Alps network stack (CXI, libfabric, NCCL, aws-ofi-nccl, NVSHMEM)
BASE_IMAGE=nvcr.io/nvidia/vllm:26.04-py3
NGC_VARIANT_DIR=""

# Stage 2: vLLM pin on top of the alps base
VLLM_VERSION=0.20.1

# Canonical tags (§8.1; ml is a docker-type JFrog repo)
REGISTRY=jfrog.svc.cscs.ch/ml/inference
ALPS_BASE_TAG=${REGISTRY}/vllm-alps-base:ngc26.04-${ALPS_STACK_COMMIT}
IMAGE_TAG=${REGISTRY}/vllm:${VLLM_VERSION}-ngc26.04-${ALPS_STACK_COMMIT}
