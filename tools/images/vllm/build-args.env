# Image pins (SPECIFICATIONS.md §8.1). Sourced by build.sbatch.

# NGC vLLM release this image extends with the Alps network stack.
BASE_IMAGE=nvcr.io/nvidia/vllm:26.05-py3

# Canonical tag: mirrors the NGC name, marked as the Alps variant.
# (ml is a docker-type JFrog repo; the push creates the inference/ path.)
IMAGE_TAG=jfrog.svc.cscs.ch/ml/inference/vllm:26.05-py3-alps
