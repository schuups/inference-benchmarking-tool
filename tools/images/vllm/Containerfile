# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

ARG VLLM_VERSION=0.20.1

# Install vLLM.
#
# The NGC PyTorch base already has torch, flash-attn, and the Alps HPC stack
# has NCCL built from source at /usr (picked up first by ldconfig). vLLM will
# pull in nvidia-nccl-cu12 as a Python dep; that copy lives under site-packages
# and does not override the system libnccl.so.2. The alps-runtime.env variables
# (NCCL_NET, FI_PROVIDER, …) steer NCCL to the CXI plugin at runtime.
RUN set -eux; \
    pip install --no-cache-dir \
        -i https://jfrog.svc.cscs.ch/artifactory/api/pypi/pypi-remote/simple \
        "vllm==${VLLM_VERSION}"
