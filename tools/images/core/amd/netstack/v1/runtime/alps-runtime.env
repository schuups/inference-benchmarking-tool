# -----------------------------------------------------------------------------
# Helper: set default only if UNSET, then export
# -----------------------------------------------------------------------------
# Usage:
#   defvar VAR "default value"
#
# Semantics:
# - If VAR is unset: set it to the provided default.
# - If VAR is set (even if empty): do not touch it.
# - Always export VAR.
#
# MUST be POSIX-sh compatible: this file is sourced by /bin/sh (dash on Ubuntu)
# from /etc/profile.d at container start, AND by bash via BASH_ENV. Bash-only
# constructs (${!name+x}, printf -v, [[ ]]) raise "Bad substitution" under dash
# and abort container init — so use eval-based indirection and `[` only.
defvar() {
  _dv_name="$1"; shift
  _dv_val="$*"
  eval "_dv_isset=\${$_dv_name+x}"
  if [ -z "$_dv_isset" ]; then
    eval "$_dv_name=\$_dv_val"
  fi
  eval "export $_dv_name"
}

# -----------------------------------------------------------------------------
# RCCL defaults
# -----------------------------------------------------------------------------
# RCCL is API-compatible with NCCL and reads the NCCL_* environment variables.
# These mirror the NVIDIA netstack's Slingshot tuning, MINUS the GH200-specific
# knobs (NVLink P2P level, Grace-Hopper C2C) which do not apply to MI300A.

# Informational markers; injected at build time into alps-versions.env.
defvar NCCL_VERSION "${NCCL_VERSION:-}"
defvar AWS_OFI_RCCL_VERSION "${AWS_OFI_RCCL_VERSION:-}"

# Force RCCL onto the libfabric (aws-ofi-rccl) plugin so it uses Slingshot. If
# the plugin is missing, apps fail to start rather than silently falling back to
# TCP (far slower). Same contract as NCCL_NET on the NVIDIA stack.
defvar NCCL_NET "AWS Libfabric"

# Use the Slingshot high-speed interfaces (hsn prefix).
defvar NCCL_SOCKET_IFNAME "hsn"

# Allow different NICs for the same ring/tree — suited to Slingshot's topology.
defvar NCCL_CROSS_NIC "1"

# GPU Direct RDMA when GPU and NIC share a NUMA node. NCCL_NET_GDR_C2C (Grace-
# Hopper C2C) and NCCL_P2P_LEVEL=NVL (NVLink) are intentionally DROPPED — MI300A
# uses Infinity Fabric / xGMI, not NVLink/C2C. Tuning of these for MI300A is a
# follow-up (TODOs.md).
defvar NCCL_NET_GDR_LEVEL "PHB"
defvar NCCL_NET_GDR_READ "1"

# LL128 typically underperforms on Slingshot; disable it (RCCL honours this).
defvar NCCL_PROTO "^LL128"

# Network channels per pairwise peer.
defvar NCCL_NCHANNELS_PER_NET_PEER "4"

# -----------------------------------------------------------------------------
# Libfabric / CXI defaults  (identical to the NVIDIA stack — same Slingshot NIC)
# -----------------------------------------------------------------------------
defvar FI_PROVIDER "cxi"

defvar FI_CXI_DEFAULT_CQ_SIZE "131072"
defvar FI_CXI_DEFAULT_TX_SIZE "16384"

# Disable registration of host buffers (overflow and request) with the GPU.
# https://ofiwg.github.io/libfabric/v2.1.0/man/fi_cxi.7.html
defvar FI_CXI_DISABLE_HOST_REGISTER "1"

# Rendezvous settings: threshold/get-min at 0 enforce a consistent rdzv path.
defvar FI_CXI_RDZV_PROTO "alt_read"
defvar FI_CXI_RDZV_EAGER_SIZE "0"
defvar FI_CXI_RDZV_GET_MIN "0"
defvar FI_CXI_RDZV_THRESHOLD "0"

# Offloaded message matching, falling back to hybrid hw/sw when exhausted.
defvar FI_CXI_RX_MATCH_MODE "hybrid"

# userfaultfd MR cache monitor — required when running NCCL or RCCL over CXI.
defvar FI_MR_CACHE_MONITOR "userfaultfd"
defvar FI_MR_CACHE_MAX_SIZE "-1"
defvar FI_MR_CACHE_MAX_COUNT "524288"

# Max CPU memcpy size for HMEM device memory accessible by the CPU via load/store.
defvar FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD "16777216"

# -----------------------------------------------------------------------------
# PMIx / OpenMPI defaults  (identical to the NVIDIA stack)
# -----------------------------------------------------------------------------
defvar PMIX_MCA_psec "native"

defvar OMPI_MCA_btl "^tcp,uct,usnic"
defvar OMPI_MCA_pml "cm"
defvar OMPI_MCA_mtl "ofi"
defvar OMPI_MCA_opal_common_ofi_provider_include "cxi"

# -----------------------------------------------------------------------------
# rocSHMEM defaults
# -----------------------------------------------------------------------------
# Informational marker; injected at build time into alps-versions.env. rocSHMEM's
# libfabric backend uses the FI_* CXI settings above; provider-specific tuning is
# a follow-up once the rocSHMEM-over-CXI path is characterised on Alps.
defvar ROCSHMEM_VERSION "${ROCSHMEM_VERSION:-}"
